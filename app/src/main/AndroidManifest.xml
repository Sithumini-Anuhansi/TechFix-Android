<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.TechFix">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <provider
            android:name=".data.TechFixProvider"
            android:authorities="com.techfix.app.provider"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.techfix.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TechFix.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.LoginActivity" android:exported="false" />
        <activity android:name=".ui.auth.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.customer.CustomerHomeActivity" android:exported="false" />
        <activity android:name=".ui.customer.ServiceListActivity" android:exported="false" />
        <activity android:name=".ui.customer.ServiceDetailActivity" android:exported="false" />
        <activity android:name=".ui.customer.BookRepairActivity" android:exported="false" />
        <activity android:name=".ui.customer.MyAppointmentsActivity" android:exported="false" />
        <activity android:name=".ui.customer.AppointmentTrackActivity" android:exported="false" />
        <activity android:name=".ui.customer.RepairHistoryActivity" android:exported="false" />
        <activity android:name=".ui.customer.BranchMapActivity" android:exported="false" />
        <activity android:name=".ui.staff.StaffDashboardActivity" android:exported="false" />
        <activity android:name=".ui.staff.StaffAppointmentsActivity" android:exported="false" />
        <activity android:name=".ui.staff.StaffAppointmentDetailActivity" android:exported="false" />
        <activity android:name=".ui.staff.StaffTechniciansActivity" android:exported="false" />
        <activity android:name=".ui.staff.StaffPartsActivity" android:exported="false" />
        <activity android:name=".ui.staff.StaffPaymentsActivity" android:exported="false" />
        <activity android:name=".ui.staff.StaffBranchesActivity" android:exported="false" />
        <activity android:name=".ui.staff.StaffPhotosActivity" android:exported="false" />
    </application>
</manifest>
