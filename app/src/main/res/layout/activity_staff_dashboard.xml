<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppointments"
                style="@style/Widget.TechFix.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Repair appointments" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTechnicians"
                style="@style/Widget.TechFix.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Technicians" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnParts"
                style="@style/Widget.TechFix.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Spare parts stock" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPayments"
                style="@style/Widget.TechFix.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Payments" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhotos"
                style="@style/Widget.TechFix.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Repaired device photos" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBranches"
                style="@style/Widget.TechFix.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Branches" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
